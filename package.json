{
  "name": "dimo-subscription-demo",
  "version": "2.40.4",
  "author": "Bean Jackson <jaggedbytes@protonmail.com>",
  "contributors": [
    "Ixartz (https://github.com/ixartz)"
  ],
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "dev:codegen": "graphql-codegen --watch",
    "dev:spotlight": "spotlight",
    "dev:next": "next dev --turbopack --experimental-https --experimental-https-key ./local.dimo.org+2-key.pem --experimental-https-cert ./local.dimo.org+2.pem",
    "dev": "npm run codegen && run-p dev:*",
    "build": "npm run codegen && next build",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit --pretty",
    "commit": "cz",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:serve": "http-server storybook-static --port 6006 --silent",
    "serve-storybook": "run-s storybook:*",
    "codegen": "graphql-codegen"
  },
  "dependencies": {
    "@arcjet/next": "^1.15.0",
    "@dimo-network/login-with-dimo": "^0.0.35",
    "@hookform/resolvers": "^6.0.2",
    "@logtail/pino": "^0.5.12",
    "@sentry/nextjs": "^11.10.0",
    "@stripe/stripe-js": "^7.10.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@turnkey/api-key-stamper": "0.6.17",
    "@turnkey/crypto": "2.13.2",
    "@turnkey/encoding": "0.6.0",
    "@turnkey/ethers": "1.3.43",
    "@turnkey/http": "6.6.0",
    "@turnkey/sdk-browser": "8.6.0",
    "@turnkey/viem": "0.14.43",
    "@types/classnames": "^2.3.4",
    "@zerodev/ecdsa-validator": "^5.4.9",
    "@zerodev/sdk": "^5.5.11",
    "autoprefixer": "^10.6.2",
    "classnames": "^2.5.1",
    "graphql": "^17.0.2",
    "jose": "^6.2.14",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "posthog-js": "^1.443.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "stripe": "^18.3.0",
    "viem": "2.56.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@faker-js/faker": "^10.6.0",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@next/bundle-analyzer": "^16.4.3",
    "@next/eslint-plugin-next": "^16.4.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@spotlightjs/spotlight": "^4.12.1",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-links": "^10.6.5",
    "@storybook/addon-onboarding": "^10.6.5",
    "@storybook/nextjs": "^10.6.5",
    "@storybook/react": "^10.6.5",
    "@storybook/test-runner": "^0.26.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/expect": "^5.0.5",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-testing-library": "^7.16.2",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.32",
    "postcss-load-config": "^6.0.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "start-server-and-test": "^3.0.13",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "vitest-fail-on-console": "^0.10.1"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "overrides": {
    "@types/react": "19.3.0",
    "eslint": "$eslint"
  }
}
